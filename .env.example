# --- Auth (NextAuth v5) ---
AUTH_SECRET=            # npx auth secret
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Firebase Admin SDK (SHARED with werewolf-ai-party-game — same project & service
# account; poker owns poker_-prefixed collections, only `config` is shared) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Logging (optional; console-only when unset) ---
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=

# --- Stripe (balance top-ups; checkout is stubbed until these are set and the stub
# in app/actions/stripe-actions.ts + app/api/webhooks/stripe/route.ts is implemented) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=            # e.g. http://localhost:3000
NEXT_PUBLIC_STRIPE_PRICE_1=
NEXT_PUBLIC_STRIPE_PRICE_3=
NEXT_PUBLIC_STRIPE_PRICE_5=
NEXT_PUBLIC_STRIPE_PRICE_10=

# --- AI provider keys (dev fallbacks) ---
# Every tier plays on the platform keys in the shared config/freeTierApiKeys Firestore
# doc; for local dev, any key missing there falls back to these vars (werewolf's naming).
# All optional — set the ones you have.
ANTHROPIC_K=
OPENAI_K=
GOOGLE_K=
MISTRAL_K=
DEEP_SEEK_K=
GROK_K=
MOONSHOT_K=      # Kimi
Z_K=             # Z.AI / GLM
GW_K=            # Qwen
MX_K=            # MiniMax
FUGU_K=          # Sakana
