# --- Auth (NextAuth v5) ---
AUTH_SECRET=            # npx auth secret
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Firebase Admin SDK (SHARED with werewolf-ai-party-game — same project & service
# account; poker owns poker_-prefixed collections, only `config` is shared) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Logging (optional; console-only when unset) ---
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=

# --- AI provider keys (dev fallbacks) ---
# Users normally store their own keys in poker_users/{email}.apiKeys ("Your keys" tier).
# For local dev, any key missing there falls back to these vars (werewolf's naming).
# All optional — set the ones you have; the model picker only offers providers with keys.
ANTHROPIC_K=
OPENAI_K=
GOOGLE_K=
MISTRAL_K=
DEEP_SEEK_K=
GROK_K=
MOONSHOT_K=      # Kimi
Z_K=             # Z.AI / GLM
GW_K=            # Qwen
MX_K=            # MiniMax
FUGU_K=          # Sakana
