    "Button": "components/ui/Button.tsx",
    "CapsLabel": "components/ui/CapsLabel.tsx",
    "ChatBubble": "components/ui/ChatBubble.tsx",
    "Panel": "components/ui/Panel.tsx",
    "Pill": "components/ui/Pill.tsx",
    "PlayingCard": "components/ui/PlayingCard.tsx",
    "SeatPill": "components/ui/SeatPill.tsx",
    "TableFelt": "components/ui/TableFelt.tsx"
  }
}
