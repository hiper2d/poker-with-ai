{
  "projectId": "5b5c24eb-c345-4c1b-80da-1fe29b448570",
  "shape": "package",
  "pkg": "poker-with-ai",
  "globalName": "PokerUI",
  "srcDir": "components/ui",
  "tsconfig": "./tsconfig.json",
  "cssEntry": ".design-sync/dist/parlor.css",
  "runtimeFontPrefixes": ["DM Sans", "Instrument Serif"],
  "readmeHeader": ".design-sync/conventions.md",
